{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Thinkbase",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#0A0B0D",
    "light": "#F5F5F5",
    "dark": "#0A0B0D"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://platform.trythinkbase.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://platform.trythinkbase.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "guides/introduction",
              "guides/authentication",
              "guides/rate-limits",
              "guides/tiers"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/trythinkbase",
      "instagram": "https://www.instagram.com/trythinkbase",
      "linkedin": "https://www.linkedin.com/company/trythinkbase/",
      "website": "https://trythinkbase.com"
    }
  }
}
